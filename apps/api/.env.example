APP_PORT=3000

DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/haciendola?sslmode=verify-full
# Owner connection, only for the seeders. Run `pnpm db:app-role -- --write-env`
# to move the owner here and point DATABASE_URL at a role that can only
# read and write rows.
DATABASE_ADMIN_URL=

JWT_SECRET=

RESEND_API_KEY=
MAIL_FROM=Haciendola <login@mail.example.com>

# Only in production: the web app's URL, so only it can call the API
# (comma-separated for several), and the secret Vercel Cron sends to run the
# daily cleanup. Leave both empty locally.
WEB_ORIGIN=
CRON_SECRET=
